{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run frontend",
			"type": "shell",
			"command": "& '${workspaceFolder}/.venv/Scripts/python.exe' -m http.server 5173 --bind 127.0.0.1 --directory '${workspaceFolder}/frontend'",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run backend",
			"type": "shell",
			"command": "& '${workspaceFolder}/.venv/Scripts/python.exe' -m uvicorn api.main:app --app-dir '${workspaceFolder}/backend' --host 127.0.0.1 --port 8000",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}